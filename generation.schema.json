{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anima V1 generation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positive_prompt",
    "negative_prompt",
    "prepend_recommended_prefix",
    "width",
    "height",
    "steps",
    "cfg_scale",
    "sigma_shift",
    "seed"
  ],
  "properties": {
    "positive_prompt": { "type": "string", "minLength": 1 },
    "negative_prompt": { "type": "string" },
    "prepend_recommended_prefix": { "type": "boolean" },
    "width": { "type": "integer", "minimum": 512, "maximum": 1536, "multipleOf": 16 },
    "height": { "type": "integer", "minimum": 512, "maximum": 1536, "multipleOf": 16 },
    "steps": { "type": "integer", "minimum": 10, "maximum": 60 },
    "cfg_scale": { "type": "number", "minimum": 1, "maximum": 8, "multipleOf": 0.1 },
    "sigma_shift": { "type": "number", "minimum": 0, "maximum": 8, "multipleOf": 0.1 },
    "seed": { "type": "integer", "minimum": -1 }
  }
}
